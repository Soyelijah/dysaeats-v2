# Copia este archivo a .env y cambia la contraseña. .env nunca se versiona.

POSTGRES_USER=dysaeats_app
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_PORT=5433

# Base de desarrollo (pnpm db:migrate, db:seed, db:reset).
DATABASE_URL=postgres://dysaeats_app:cambia_esta_contrasena@localhost:5433/dysaeats_dev

# Base de pruebas: los tests la borran y recrean. Debe terminar en _test.
TEST_DATABASE_URL=postgres://dysaeats_app:cambia_esta_contrasena@localhost:5433/dysaeats_test
